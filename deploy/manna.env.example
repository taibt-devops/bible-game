# Cấu hình máy chủ Manna trên EC2. Sao chép thành /etc/manna/manna.env (quyền 640, chủ root:manna).
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
TZ=Asia/Ho_Chi_Minh

# Tên miền người chơi mở (CloudFront), dùng để kiểm tra Origin chống CSRF.
PUBLIC_ORIGIN=https://manna.example.com

# Chuỗi bí mật CloudFront gửi kèm mỗi yêu cầu (giống tham số OriginSecret của stack CloudFront).
# Tạo bằng: openssl rand -base64 36
ORIGIN_SECRET=

# OAuth client ID loại "Web application" trong Google Cloud Console. Để trống thì tắt đăng nhập Google.
GOOGLE_CLIENT_ID=

DB_PATH=/var/lib/manna/manna.db
COOKIE_SECURE=1
SERVE_STATIC=0
# Người chơi → CloudFront → nginx → Node: IP thật nằm ở vị trí thứ 2 từ cuối trong X-Forwarded-For.
PROXY_HOPS=2
SESSION_DAYS=90

# Sao lưu hằng ngày (deploy/backup.sh). Instance role cần quyền s3:PutObject vào đường dẫn này.
BACKUP_S3_URI=s3://ten-bucket-sao-luu/manna
